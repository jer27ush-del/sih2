# Copy this file to server/.env and change the values.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Required. Use a long random string. Production refuses to start with the example value.
DATABASE_URL="file:./dev.db"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Optional. Enables AI priority analysis. Leave blank to use keyword rules.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Tuning (optional). Defaults are shown; change only after review.
# DNA_WINDOW_DAYS=180
# DNA_DUPLICATE_SCORE=0.5
# DNA_RELATED_SCORE=0.2
# SLA_HIGH_DAYS=15
# SLA_MEDIUM_DAYS=30
# SLA_LOW_DAYS=45
# DUE_SOON_DAYS=3
# HANDOFF_STALE_HOURS=48
# DEFAULT_CELL_CAPACITY=15
# READ_ONLY_AFTER_HANDOFF=true
