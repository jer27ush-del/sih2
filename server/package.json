{
  "name": "aicte-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=./src src/index.js",
    "prestart": "prisma migrate deploy",
    "start": "node src/index.js",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "test": "node --test test/dna.test.js test/routing.test.js test/workflow.test.js test/monitor.test.js test/analytics.test.js test/complaints.test.js test/csv.test.js test/plain.test.js",
    "setup": "node scripts/setup.js",
    "smoke": "node test/smoke.js",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "prisma": "5.22.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
